  test_name: 'Mock a 500 error from public drivers API',
  test_location: '/Users/j.gope/Documents/playwright-prod-js/tests/network_interception.spec.js',
  test_code: 'async ({\n' +
    '  page\n' +
    '}) => {\n' +
    '  let intercepted = false;\n' +
    "  await page.route('**/rest/v1/rpc/public_drivers', async route => {\n" +
    '    intercepted = true;\n' +
    "    console.log('Intercepted API:', route.request().url());\n" +
    '    await route.fulfill({\n' +
    '      status: 500,\n' +
    "      contentType: 'application/json',\n" +
    '      body: JSON.stringify({\n' +
    "        message: 'Internal Server Error'\n" +
    '      })\n' +
    '    });\n' +
    '  });\n' +
    '\n' +
    '  // Listen for the actual response received by the browser.\n' +
    "  page.on('response', async response => {\n" +
    "    if (response.url().includes('/rpc/public_drivers')) {\n" +
    "      console.log('API response status:', response.status());\n" +
    "      console.log('API response body:', await response.text());\n" +
    '    }\n' +
    '  });\n' +
    "  await page.goto('https://localgaadi.lovable.app/');\n" +
    '  await _test.expect.poll(() => intercepted).toBe(true);\n' +
    '  await page.pause();\n' +
    '}',
